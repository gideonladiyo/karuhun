# Karuhun Web Environment Variables Example (Copy to .env for production/local development)

# Huaxu API Base Endpoint
VITE_HUAXU_API_URL=https://api.huaxu.app

# Huaxu CDN Assets Endpoint
VITE_HUAXU_ASSETS_URL=https://assets.huaxu.app/glb

# Official Google Sheets PPC Boss Database CSV Endpoint
VITE_PPC_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1z_L4MEGv5q89OFkuN2RNI1gjajddD3_NG169_f0RNrA/gviz/tq?tqx=out:csv&sheet=ppc_boss

# Official Google Sheets Document Shareable Link
VITE_PPC_SHEET_DOC_URL=https://docs.google.com/spreadsheets/d/1z_L4MEGv5q89OFkuN2RNI1gjajddD3_NG169_f0RNrA/edit?gid=1378072876#gid=1378072876

# Karuhun Guild Discord Invite Link
VITE_DISCORD_INVITE_URL=https://discord.gg/karuhun


# Huaxu API Key (Optional for increased rate limits)
VITE_HUAXU_API_KEY=

# Supabase Credentials Configuration (Required for Strategy References CMS & Admin)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
